{
  "uid": "korp-observability",
  "title": "Projeto Korp - Observability",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Availability",
      "type": "stat",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "up{job=\"http-server-projeto-korp\"}", "datasource": {"type": "prometheus", "uid": "prometheus"}}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 2,
      "title": "Request Total",
      "type": "stat",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(projeto_korp_http_requests_total)", "datasource": {"type": "prometheus", "uid": "prometheus"}}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 3,
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(projeto_korp_http_requests_total[1m]))", "datasource": {"type": "prometheus", "uid": "prometheus"}}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    }
  ]
}
