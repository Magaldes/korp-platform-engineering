{
  "network": {
    "name": "korp-project-network",
    "driver": "bridge",
    "containers": {
      "http-server-projeto-korp": "172.22.0.2",
      "grafana": "172.22.0.3",
      "prometheus": "172.22.0.4",
      "nginx": "172.22.0.5"
    }
  },
  "containers": [
    {
      "name": "compose-http-server-projeto-korp-1",
      "service": "http-server-projeto-korp",
      "state": "running",
      "internalPort": 8080,
      "hostPorts": []
    },
    {
      "name": "compose-nginx-1",
      "service": "nginx",
      "state": "running",
      "internalPort": 80,
      "hostPorts": ["0.0.0.0:80->80/tcp", "[::]:80->80/tcp"]
    },
    {
      "name": "compose-prometheus-1",
      "service": "prometheus",
      "state": "running",
      "internalPort": 9090,
      "hostPorts": []
    },
    {
      "name": "compose-grafana-1",
      "service": "grafana",
      "state": "running",
      "internalPort": 3000,
      "hostPorts": []
    }
  ],
  "assertions": {
    "nginxPublishesHost80": true,
    "goHasNoHostPort8080": true,
    "prometheusHasNoHostPort": true,
    "grafanaHasNoHostPort": true,
    "allRequiredContainersRunningAndOnNetwork": true
  }
}
